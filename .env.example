# Copy to .env.local for local work, and paste the same names into
# Vercel → Settings → Environment Variables for the deployed site.

# ── database ──────────────────────────────────────────────────────────────
# MongoDB Atlas free tier is plenty: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ayan_textile

# ── admin login (/login) ──────────────────────────────────────────────────
# The account is created from these on the first request, then lives in the
# "admins" collection. To change the password later: edit it here and delete
# that one document — the next request recreates it.
ADMIN_EMAIL=you@ayantextile.com
ADMIN_PASSWORD=a long admin password
SESSION_SECRET=
# Keeping the password out of your Vercel settings: run
#   npm run hash -- "a long admin password"
# and set ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=scrypt:...:...

# ── enquiry email over SMTP ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
# Gmail needs an App Password, not your account password:
# https://myaccount.google.com/apppasswords (2-Step Verification must be on)
SMTP_PASS=your-16-character-app-password
ENQUIRY_TO=info@ayantextile.com
ENQUIRY_FROM=Ayan Textile <you@gmail.com>
